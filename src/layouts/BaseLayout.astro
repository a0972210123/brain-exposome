---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogType?: 'website' | 'article';
  image?: string;
  /** Extra schema.org nodes appended to this page's @graph — see src/lib/dataset-ld.mjs. */
  extraLd?: Record<string, unknown>[];
}

const {
  title,
  description = '葉淨維 Ching-Wei (Matt) Ye 的個人網站',
  lang = 'zh-TW',
  ogType = 'website',
  image = '/OG.png',
  extraLd = [],
} = Astro.props;

const siteURL = Astro.site ?? 'https://brain-exposome.mattye.dev';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);
const siteName = 'Matt Ye';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;

/* mattye.dev is the canonical home for this node — same @id, so the two must agree.
   Everything below is mirrored from https://mattye.dev/ (its own JSON-LD and page
   content); change it there first, then bring it across. This copy had drifted: it was
   missing the ORCID, X and Instagram profiles the canonical node already published. */
const personLd = {
  '@type': 'Person',
  '@id': 'https://mattye.dev/#person',
  name: 'Ching-Wei (Matt) Ye',
  alternateName: '葉淨維',
  url: 'https://mattye.dev',
  jobTitle: 'PhD Candidate · Presentation Coach',
  description: '職能治療師、研究者、溝通教育者。PhD @ NTU，專注 AI 輔助認知障礙診斷與簡報教育。',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'National Taiwan University' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'National Taiwan University' },
  /* Author expertise is the first thing a health page is judged on, so the subject
     areas here are the ones this site actually covers. */
  knowsAbout: [
    'Occupational therapy',
    'Cognitive decline',
    'Dementia risk factors',
    'AI-assisted cognitive screening',
    'Motor and handwriting analysis',
    'Science communication',
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'ORCID',
    value: 'https://orcid.org/0009-0001-6085-8303',
  },
  sameAs: [
    'https://www.linkedin.com/in/ching-wei-ye',
    'https://x.com/MattChingWeiYe',
    'https://orcid.org/0009-0001-6085-8303',
    'https://www.instagram.com/brown.yeh',
  ],
};
const websiteLd = {
  '@type': 'WebSite',
  '@id': 'https://brain-exposome.mattye.dev/#website',
  name: siteName,
  url: 'https://brain-exposome.mattye.dev',
  inLanguage: 'zh-TW',
  datePublished: '2026-05-31',
  copyrightYear: 2026,
  publisher: { '@id': 'https://mattye.dev/#person' },
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [personLd, websiteLd, ...extraLd] };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Prevent flash of wrong theme (runs before render) -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- Language preference (runs before render; default zh) -->
    <script is:inline>
      (function () {
        const lang = localStorage.getItem('lang') === 'en' ? 'en' : 'zh';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'en' ? 'en' : 'zh-TW';
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    <meta name="author" content="Ching-Wei (Matt) Ye" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <!-- Handle taken from mattye.dev, which declares @MattChingWeiYe for both site and
         creator and lists only x.com/MattChingWeiYe in its Person sameAs. -->
    <meta name="twitter:site" content="@MattChingWeiYe" />
    <meta name="twitter:creator" content="@MattChingWeiYe" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1RKL72DPPW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1RKL72DPPW');
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot name="full-width" />
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
